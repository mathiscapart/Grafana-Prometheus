# Copier en inventory.yml (non versionné) et adapter — cf. doc/ansible.md
all:
  vars:
    ansible_user: root
    # ansible_ssh_private_key_file: ~/.ssh/id_ed25519

  children:
    # Serveur qui héberge la stack (Prometheus, Alertmanager, Blackbox, Grafana)
    monitoring:
      hosts:
        192.168.1.5:
      vars:
        # Optionnel : génère prometheus/targets/<job>.json sur le serveur.
        # Un job absent de ce dictionnaire n'est pas touché (fichier géré à la main).
        monitoring_prometheus_targets:
          node: "{{ groups['node_exporter'] | map('regex_replace', '$', ':9100') | list }}"
          blackbox:
            - https://example.com/

    # Hôtes sur lesquels node_exporter est déployé
    node_exporter:
      hosts:
        192.168.1.10:
        192.168.1.11:
