# Configuration web des exporters (exporter-toolkit) — cf. doc/securisation-exporters.md
# Copier en web.yml sur chaque hôte exporter et lancer l'exporter avec --web.config.file=<chemin>/web.yml
# web.yml n'est pas versionné (.gitignore).

# Utilisateur autorisé : <EXPORTER_BASIC_AUTH_USERNAME>: <hash bcrypt de EXPORTER_BASIC_AUTH_PASSWORD>
# Générer le hash : htpasswd -nBC 10 "" | tr -d ':\n'
basic_auth_users:
  prometheus: 'XXX'

# TLS (optionnel) — si activé, passer le job en `scheme: https` dans prometheus.yml.tmpl
# tls_server_config:
#   cert_file: /etc/exporter/tls.crt
#   key_file: /etc/exporter/tls.key
