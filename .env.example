# Copier en .env puis remplacer chaque XXX (cf. doc/configuration.md).
# ⚠️ Docker Compose interprète les « $ » : une valeur qui en contient doit être entre
# apostrophes, ex. PASSWORD='Ab$cd'. Les apostrophes sont interdites dans les valeurs.
# Mot de passe sans caractère spécial : openssl rand -hex 24

# Versions des images (tags Docker Hub)
PROMETHEUS_VERSION=XXX
ALERTMANAGER_VERSION=XXX
BLACKBOX_VERSION=XXX
GRAFANA_VERSION=XXX

# Image builder d'envsubst : golang:<GO_VERSION>-alpine et tag de gomodules.xyz/envsubst (vX.Y.Z)
GO_VERSION=XXX
ENVSUBST_VERSION=XXX
# Tag de github.com/shoenig/bcrypt-tool (vX.Y.Z), hache le mot de passe basic auth de Prometheus
BCRYPT_TOOL_VERSION=XXX

# Grafana (le compte admin n'est créé qu'au premier démarrage, cf. doc/grafana.md)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=XXX
# URL publique de Grafana (liens des alertes, redirections), ex. https://grafana.example.com
GF_SERVER_ROOT_URL=XXX

# Alertmanager -> Discord (cf. doc/alertmanager-discord.md)
DISCORD_WEBHOOK_URL=XXX

# Basic auth de Prometheus (interface web et API, port 9090) ; aussi utilisé par Grafana
PROMETHEUS_BASIC_AUTH_USERNAME=XXX
PROMETHEUS_BASIC_AUTH_PASSWORD=XXX

# Basic auth des exporters, un couple par exporter : utilisé par Prometheus pour scraper,
# et par les scripts exporter/*.sh pour générer le web.yml (cf. doc/securisation-exporters.md)
NODE_BASIC_AUTH_USERNAME=XXX
NODE_BASIC_AUTH_PASSWORD=XXX
MYSQL_BASIC_AUTH_USERNAME=XXX
MYSQL_BASIC_AUTH_PASSWORD=XXX
NGINX_BASIC_AUTH_USERNAME=XXX
NGINX_BASIC_AUTH_PASSWORD=XXX
APACHE_BASIC_AUTH_USERNAME=XXX
APACHE_BASIC_AUTH_PASSWORD=XXX
