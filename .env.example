# Copier en .env puis remplacer chaque XXX (cf. doc/configuration.md).

# Versions des images (tags Docker Hub)
PROMETHEUS_VERSION=XXX
ALERTMANAGER_VERSION=XXX
BLACKBOX_VERSION=XXX
GRAFANA_VERSION=XXX

# Image builder d'envsubst : golang:<GO_VERSION>-alpine
GO_VERSION=XXX

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=grafana

# Alertmanager -> Discord (cf. doc/alertmanager-discord.md)
DISCORD_WEBHOOK_URL=XXX

# Identifiants utilisés par Prometheus pour scraper les exporters (cf. doc/securisation-exporters.md)
EXPORTER_BASIC_AUTH_USERNAME=XXX
EXPORTER_BASIC_AUTH_PASSWORD=XXX
